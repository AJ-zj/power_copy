# 统一换行策略：仓库内统一 LF，检出时不转换
* text=auto eol=lf

# 二进制文件：禁止任何换行转换，避免损坏
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.db binary
*.sqlite3 binary
*.zip binary

# 脚本与配置显式声明为文本
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.ps1 text eol=crlf
