# PowerCopy V2 环境配置模板
# 复制为 .env 后填写；.env 不进版本库。

# ---------------------------------------------------------------- 旧版配置
# 由 powercopy/core/llm.py 直接读取
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT=60

# ---------------------------------------------------------------- 新版配置
# 由 powercopy/core/config.py 读取，供 API 与工作台使用
POWERCOPY_ENV=development
POWERCOPY_LLM_BASE_URL=
POWERCOPY_LLM_MODEL=
POWERCOPY_LLM_API_KEY=
POWERCOPY_LLM_TIMEOUT=90
POWERCOPY_TAVILY_API_KEY=
POWERCOPY_DATA_DIR=workspace/data

# ---------------------------------------------------------------- 政策库
# 只读查询工具与切片构建使用的版本化数据库路径
POLICY_DB_PATH=storage/policies_versioned.db
